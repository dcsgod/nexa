# ─────────────────────────────────────────────────────────────
# Nexa environment configuration
# Copy to .env and fill in. Mock mode needs NOTHING here to run.
# ─────────────────────────────────────────────────────────────

# --- Runtime mode ---------------------------------------------
# mock  = fully local, seeded data, no Databricks required (DEFAULT)
# live  = connect to a real Databricks workspace
NEXA_MODE=mock

# --- Node API -------------------------------------------------
API_PORT=8080
API_LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# --- Python AI engine -----------------------------------------
AI_ENGINE_URL=http://localhost:8100

# --- Databricks (only used when NEXA_MODE=live) ---------------
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Optional PAT fallback for local dev against a real workspace:
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main

# --- Genie (only used when NEXA_MODE=live) --------------------
GENIE_SPACE_ID=

# --- Vector store (optional; native vector search preferred) --
QDRANT_URL=
QDRANT_API_KEY=
